{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}

        org.apache.logging.log4j/log4j-api {:mvn/version "2.26.1"}
        ;; bridge into log4j:
        org.apache.logging.log4j/log4j-1.2-api {:mvn/version "2.26.1"}
        org.apache.logging.log4j/log4j-jcl {:mvn/version "2.26.1"}
        org.apache.logging.log4j/log4j-jul {:mvn/version "2.26.1"}
        org.apache.logging.log4j/log4j-slf4j-impl {:mvn/version "2.26.1"}
        org.apache.logging.log4j/log4j-slf4j2-impl {:mvn/version "2.26.1"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                org.clojure/tools.logging {:mvn/version "1.3.1"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test
   ;; provided as an example of what JVM options are needed:
   :jvm-opts ["-Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager"
              "-Dlog4j2.julLoggerAdapter=org.apache.logging.log4j.jul.CoreLoggerAdapter"]}
  :1.11 {:override-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :1.12 {:override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}}
  :1.13 {:override-deps {org.clojure/clojure {:mvn/version "1.13.0-alpha4"}}}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
